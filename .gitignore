# macOS
.DS_Store

# Xcode
DerivedData/
build/
# The Quality and Speed site's Build page is source, not Xcode output.
!/quality-speed/pages/build/
*.xcuserstate
xcuserdata/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
# Per-account signing team for Legallas.app (see LegallasApp/Config/Signing.xcconfig.example)
LegallasApp/Config/Signing.xcconfig
# A room's own app identity and settings (see LegallasApp/Config/Room.xcconfig.example and AppSettings.swift)
LegallasApp/Config/Room.xcconfig
Sources/LegallasCore/Persistence/*+Room.swift
Sources/LegallasCore/Models/*+Room.swift

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Case data (never commit the live store, documents, or inbox)
*.store
*.store-shm
*.store-wal
# Any copy of a store too, as SECURITY.md says (*.store*): planted.store.bak, x.store~ (#374). Source files keep their names.
*.store*
!*.store.ts
!*.store.swift
!*.store.test.ts
CaseData/
**/legallas-inbox/
legallas-export.json
# A case folder copied in from ~/Documents, whatever its name
/Documents/

# Claude Code session orchestration logs
.claude/logs/*.log
.claude/logs/*.tar.gz
.claude/logs/review_report_*.md
.claude/logs/deploy_report_*.md
.claude/logs/pending_claudemd.md
.claude/logs/last_test_counts
.claude/logs/review_lint_result
.claude/logs/review_test_result
.claude/logs/.hook.lock*

# Xcode (additional catch-all pattern for cleanup script)
xcuserdata/

# Claude Code worktrees
.claude/worktrees/

# Counsel room (web/): build output, local state, secrets and the matter config never get committed
web/node_modules
quality-speed/node_modules
# Written by a page's lane. A committed copy would win over the lane's for good.
quality-speed/pages/*/law.json
quality-speed/pages/*/metrics.json
web/dist/
web/.astro/
web/.wrangler/
web/.dev.vars
web/legallas.config.json
web/room.config.json

# Local planning docs (work product; keep local, never commit)
agent-plan/

# A room's own Wrangler settings; the examples are committed.
web/wrangler.jsonc
web/wrangler.mcp.jsonc
web/wrangler.backup.jsonc

# Credentials, whatever they are called; the examples are committed.
.env
.env.*
!.env.example
.envrc
web/.dev.vars.*
!web/.dev.vars.example
*.pem
*.p8
*.p12
*.mobileprovision
id_rsa
id_dsa
id_ecdsa
id_ecdsa_sk
id_ed25519
id_ed25519_sk

# Python bytecode
__pycache__/

# Generated by `wrangler types` in `npm run check`
web/worker/worker-configuration.d.ts
