  {
   "id": "ci",
   "name": "CI",
   "why": "A push, from the cheapest lane that can run it to main, on free minutes first",
   "critical_path": ["route", "skip", "blacksmith", "ci-ok", "queue"],
   "steps": [
    {"id": "route", "name": "Route", "tools": ["Claude Code cloud session VM", "GitHub Codespaces", "Blacksmith", "GitHub-hosted"], "rule": "Heavy or one-off work runs on a cloud session's own VM, 0 Actions minutes; a job holding no secret on Blacksmith; a secret or write token on GitHub-hosted.", "rule_ref": "CLAUDE.md", "metric": "legallas.actions.usd_per_merge"},
    {"id": "skip", "name": "Path skip", "tools": [".github/scripts/changed-paths.sh"], "rule": "An area's jobs run only when its paths change.", "rule_ref": ".github/workflows/ci.yml", "metric": "legallas.actions.billed_minutes_per_merge"},
    {"id": "blacksmith", "name": "Blacksmith", "tools": ["Blacksmith free minutes", "build_minutes_guard.py"], "rule": "Jobs holding no secret run on Blacksmith while the repo is under 1,800 minutes in 31 days.", "rule_ref": ".github/scripts/build_minutes_guard.py", "metric": "legallas.actions.blacksmith_minutes_31d"},
    {"id": "hosted", "name": "GitHub-hosted", "tools": ["ubuntu-latest", "Enterprise included minutes"], "rule": "Past the Blacksmith share, or holding a secret: GitHub-hosted, inside the included minutes.", "rule_ref": "CLAUDE.md", "metric": "legallas.actions.allowance_forecast_usd"},
    {"id": "ci-ok", "name": "ci-ok", "tools": ["ci-ok on ubuntu-slim"], "rule": "One required check sums every job.", "rule_ref": ".github/workflows/ci.yml", "metric": "legallas.actions.green_minutes_p50"},
    {"id": "queue", "name": "Merge queue", "tools": ["GitHub merge queue", "Squash merge"], "rule": "The queue reruns ci-ok on the PR plus main, nothing more.", "rule_ref": "CLAUDE.md", "metric": "legallas.ci-overview.repeat_runs_per_merge"}
   ]
  },
  {
   "use": "delivery",
   "why": "A Legallas change, from a card or issue to squash-merged on main",
   "time_bar": null,
   "ideal": "Small changes, verified before review, green on the first push, reviewed at the head in one round, merged within a day, on few tokens.",
   "sources": [
    {"title": "Anthropic: How the Claude Code team does code review", "url": "https://claude.dev/blog/solving-code-review-at-anthropic/", "date": "2026-10-15"},
    {"title": "Claude Code: best practices", "url": "https://code.claude.com/docs/en/best-practices", "date": "2026-11-04"},
    {"title": "Google engineering practices: speed of code reviews", "url": "https://google.github.io/eng-practices/review/reviewer/speed.html", "date": "2026-11-04"},
    {"title": "Trunk Based Development: short-lived feature branches", "url": "https://trunkbaseddevelopment.com/short-lived-feature-branches/", "date": "2026-11-04"},
    {"title": "Claude Code: manage costs", "url": "https://code.claude.com/docs/en/costs", "date": "2026-11-06"}
   ],
   "steps": {
    "plan": {"tools": ["Plan mode", "Worktree per session"], "rule": "One card or issue per PR, 400 changed lines at most.", "rule_ref": "CLAUDE.md", "metric": "legallas.pull-requests.small_changes"},
    "build": {"tools": ["Claude Code", "Sonnet subagents for reading and mechanical fixes"], "rule": "Keep the main context small: delegate reading to subagents; one task per session.", "rule_ref": "quality-speed/pages/claude-code/PLAN.md", "metric": "legallas.claude-code.tokens_per_merged_change"},
    "ci": {"tools": ["Verified row: checks run and their output", "checks", "ci-ok", "dco"], "rule": "Show the checks' output before review; green on the first push.", "rule_ref": ".github/pull_request_template.md", "metric": "legallas.ci-overview.pushes_per_merge"},
    "review": {"tools": ["Orchestrator session", "merging skill"], "rule": "The orchestrator reviews the head in one round, three at most; its verdict names the sha; workers never merge.", "rule_ref": "https://claude.dev/blog/solving-code-review-at-anthropic/", "metric": "legallas.ci-overview.reviews_per_merge"},
    "merge": {"tools": ["Merge queue", "Squash merge"], "rule": "ci-ok and dco green on the head, then the queue.", "rule_ref": "CLAUDE.md", "metric": "legallas.ci-overview.final_push_to_merge_p50"}
   }
