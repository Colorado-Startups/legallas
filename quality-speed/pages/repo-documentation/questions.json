{
  "about": "The fixed question set. Each answer must be stated in `doc`, proved by `truth` against the code (comments stripped, unless a truth says `comments: true`), and no doc or config comment may say what `conflicts` matches. An agent answers from the docs alone; `accept` patterns must all match its answer and no `reject` pattern may. `entry` is where a reader starts: CLAUDE.md for an agent, README.md for a person. This file is pinned in inputs.lock.json: changing it needs a change entry there with the reviewer's sign-off.",
  "version": 3,
  "questions": [
    {
      "id": "q01",
      "audience": "agent",
      "question": "Which npm command fills a local room with the fictional test data, and from which folder do you run it?",
      "accept": [
        "npm run dev:seed",
        "\\bweb\\b"
      ],
      "doc": {
        "path": "web/README.md",
        "pattern": "npm run dev:seed"
      },
      "truth": [
        {
          "kind": "script",
          "name": "dev:seed"
        }
      ],
      "reject": [
        "docs do not say",
        "not (stated|documented|mentioned)"
      ]
    },
    {
      "id": "q02",
      "audience": "agent",
      "question": "What is the fictional test fixture called, and what is its control prefix?",
      "accept": [
        "Doe v\\.? Harbor Labs",
        "\\bDOE\\b"
      ],
      "doc": {
        "path": "CLAUDE.md",
        "pattern": "Doe v\\.\\s+Harbor Labs, control prefix `DOE`"
      },
      "truth": [
        {
          "kind": "grep",
          "path": "web/scripts/dev-seed.ts",
          "pattern": "matterTitle: 'Doe v\\. Harbor Labs"
        },
        {
          "kind": "grep",
          "path": "web/scripts/dev-seed.ts",
          "pattern": "controlPrefix: 'DOE'"
        }
      ],
      "conflicts": [
        "Doe v\\.\\s+Roe room",
        "fixture \\(Doe v\\.\\s+Roe"
      ],
      "reject": [
        "docs do not say",
        "not (stated|documented|mentioned)"
      ]
    },
