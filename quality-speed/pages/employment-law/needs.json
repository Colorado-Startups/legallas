  "questions": [
    {
      "id": "employment-law-final-pay-discharge",
      "question": "If we fire an employee in Colorado, how soon do we have to give them their final paycheck?",
      "expect": [
        "C.R.S. § 8-4-109(1)(a)"
      ]
    },
    {
      "id": "employment-law-final-pay-resignation",
      "question": "One of our Colorado employees just gave notice that she is quitting. When is her last paycheck due?",
      "expect": [
        "C.R.S. § 8-4-109(1)(b)"
      ]
    },
    {
      "id": "employment-law-unpaid-wage-demand-penalty",
      "question": "A former employee sent us a written demand saying we owe her an unpaid bonus. What happens under Colorado law if we don't pay within two weeks?",
      "expect": [
        "C.R.S. § 8-4-109(3)(b)"
      ]
    },
    {
      "id": "employment-law-local-minimum-wage",
      "question": "Our office is in Denver. Can a Colorado city make us pay a higher minimum wage than the state minimum?",
      "expect": [
        "C.R.S. § 8-6-101(3)"
      ]
    },
    {
      "id": "employment-law-federal-exempt-salary-floor",
      "question": "Our first software engineer will be on a salary. Under federal law, what is the lowest salary we can pay and still treat them as exempt from overtime?",
      "expect": [
        "29 C.F.R. § 541.600",
        "29 C.F.R. § 541.400"
      ]
    },
    {
      "id": "employment-law-colorado-contractor-test",
      "question": "We want to pay a Colorado developer as an independent contractor instead of hiring them. What test does Colorado use to decide whether they are really a contractor?",
      "expect": [
        "C.R.S. § 8-70-115(1)(b)",
        "C.R.S. § 8-70-115(1)(c)",
        "C.R.S. § 8-4-101(5)"
      ]
    },
    {
      "id": "employment-law-misclassification-fines",
      "question": "What fines can Colorado charge us if it finds we treated an employee as a contractor?",
      "expect": [
        "C.R.S. § 8-4-113(1)(a)"
      ]
    },
    {
      "id": "employment-law-flsa-contractor-test",
      "question": "Under federal wage and hour law, how do we tell whether our freelance designer is legally an employee who is owed minimum wage and overtime?",
      "expect": [
        "29 C.F.R. § 795.105",
        "29 C.F.R. § 795.110"
      ]
    },
    {
      "id": "employment-law-workers-comp-first-employee",
      "question": "We are about to hire our first and only employee in Colorado. Do we already need workers' compensation insurance?",
      "expect": [
        "C.R.S. § 8-44-101",
        "C.R.S. § 8-40-203(1)(b)"
      ]
    },
    {
      "id": "employment-law-noncompete-junior-staff",
      "question": "Can we make every new Colorado employee sign a non-compete, including junior engineers?",
      "expect": [
        "C.R.S. § 8-2-113(2)"
      ]
    },
    {
      "id": "employment-law-noncompete-separate-notice",
      "question": "We want a senior Colorado hire who earns well above the state's threshold to sign a non-compete. What notice do we have to give, and by when?",
      "expect": [
        "C.R.S. § 8-2-113(4)"
      ]
    },
    {
      "id": "employment-law-noncompete-acquired-founder",
      "question": "We are buying a small startup. One founder owns a minority stake she got as equity for her work. How long can the non-compete in the purchase agreement last for her?",
      "expect": [
        "C.R.S. § 8-2-113(3)(c)"
      ]
    },
    {
      "id": "employment-law-trap-federal-noncompete-ban",
      "question": "I read that the FTC banned non-competes nationwide. Does that mean we no longer have to worry about Colorado's non-compete rules for our employees?",
      "expect": [
        "C.R.S. § 8-2-113"
      ],
      "mustNot": [
        "FTC'?s? (non-?compete )?(rule|ban) (is|remains|has been|went) (now )?(in effect|in force|effective|into effect)",
        "non-?competes? (are|is) (now )?(banned|illegal|prohibited|void) (nationwide|nationally|everywhere|under federal law|across the (country|united states))",
        "(no longer|don'?t|do not) (need|have) to (worry about|follow|comply with) (colorado|the state)"
      ]
    },
    {
      "id": "employment-law-trap-delaware-choice-of-law",
      "question": "We are a Delaware corporation and our employment agreements say Delaware law governs. Can we enforce a non-compete under Delaware law against an engineer who lives and works in Colorado?",
      "expect": [
        "C.R.S. § 8-2-113(6)"
      ],
      "mustNot": [
        "delaware law (governs|controls|will govern|will control|would govern|would control) (the|this|your|her|his|their|that) (non-?compete|covenant|restrictive covenant)",
        "(choice[- ]of[- ]law|governing[- ]law) (clause|provision|term) (is|will be|would be) (enforceable|enforced|upheld|honored|respected|valid|controlling)",
        "can enforce (the|this|her|his|your|that|a) non-?compete under delaware law"
      ]
    },
