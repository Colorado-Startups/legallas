  "questions": [
    {
      "id": "colorado-regulatory-agencies-securities-regulator",
      "question": "Which Colorado state office enforces the Colorado Securities Act, and which department is it part of?",
      "expect": ["C.R.S. § 11-51-701", "C.R.S. § 11-51-703"]
    },
    {
      "id": "colorado-regulatory-agencies-small-offering",
      "question": "Without relying on federal Rule 506, how many people in Colorado can our startup offer stock to, and how many can buy, in a year under Colorado's own limited offering exemption?",
      "expect": ["C.R.S. § 11-51-308"]
    },
    {
      "id": "colorado-regulatory-agencies-missed-notice",
      "question": "We raised a Rule 506(b) round that included several Colorado investors and never made Colorado's notice filing. Can those investors demand their money back only because the notice was missed?",
      "expect": ["C.R.S. § 11-51-604"]
    },
    {
      "id": "colorado-regulatory-agencies-crowdfunding-limits",
      "question": "Our Colorado LLC wants to raise money from Colorado residents under the state's own crowdfunding exemption. What is the most we can raise in 12 months, and how much can an investor who isn't accredited put in?",
      "expect": ["C.R.S. § 11-51-308.5"]
    },
    {
      "id": "colorado-regulatory-agencies-crowdfunding-notice",
      "question": "How far ahead of starting a Colorado crowdfunding offering does the company have to make its notice filing with the securities commissioner?",
      "expect": ["C.R.S. § 11-51-308.5"]
    },
    {
      "id": "colorado-regulatory-agencies-finder-licence",
      "question": "Our startup wants to pay a friend 5% of whatever she brings in from angel investors in Colorado. Does Colorado require her to hold a license to do that?",
      "expect": ["C.R.S. § 11-51-401"]
    },
    {
      "id": "colorado-regulatory-agencies-unregistered-sale-deadline",
      "question": "Two and a half years ago I bought shares as an angel in a sale that was neither registered nor exempt, from a seller who wasn't licensed. Can I still sue for my money back under the Colorado Securities Act?",
      "expect": ["C.R.S. § 11-51-604"]
    },
    {
      "id": "colorado-regulatory-agencies-fraud-deadline",
      "question": "Last month an angel learned that a founder lied about revenue when selling him shares four years ago. How long does he have to bring a Colorado securities fraud claim?",
      "expect": ["C.R.S. § 11-51-604"]
    },
    {
      "id": "colorado-regulatory-agencies-no-office-adviser",
      "question": "An investment adviser with no place of business in Colorado has had four Colorado clients, none of them institutions, over the past 12 months. Does it need a Colorado license?",
      "expect": ["C.R.S. § 11-51-402"]
    },
    {
      "id": "colorado-regulatory-agencies-covered-adviser-notice",
      "question": "Our venture fund's management company is registered with the SEC as an investment adviser and has an office in Denver. What does it file with Colorado, and when does that filing run out?",
      "expect": ["C.R.S. § 11-51-403", "C.R.S. § 11-51-401"]
    },
    {
      "id": "colorado-regulatory-agencies-small-employer",
      "question": "We're a three-person startup in Colorado. Does Colorado's employment discrimination law apply to us, or only to larger employers?",
      "expect": ["C.R.S. § 24-34-401", "C.R.S. § 24-34-402"],
      "mustNot": ["only (?:applies|apply) to employers with (?:at least )?(?:15|fifteen|20|twenty)"]
    },
    {
      "id": "colorado-regulatory-agencies-charge-deadline",
      "question": "A former employee says we let her go because of her age. How long does she have to file a charge with the Colorado Civil Rights Commission?",
      "expect": ["C.R.S. § 24-34-403"],
      "mustNot": ["(?:within|has|have) (?:six|6) months"]
    },
    {
      "id": "colorado-regulatory-agencies-nondisclosure",
      "question": "Can a Colorado separation agreement stop a departing employee from talking about the harassment complaint she made?",
      "expect": ["C.R.S. § 24-34-407"]
    },
    {
      "id": "colorado-regulatory-agencies-personnel-records",
      "question": "How long does a Colorado employer have to keep job applications and records of employee complaints?",
      "expect": ["C.R.S. § 24-34-408"]
    },
    {
      "id": "colorado-regulatory-agencies-rescission-offer",
      "question": "We sold shares to a Colorado angel without a valid exemption. If we offer in writing to buy them back with interest before she sues, does that stop her claim under the Colorado Securities Act?",
      "expect": ["C.R.S. § 11-51-604"]
    },
    {
      "id": "colorado-regulatory-agencies-charge-first",
      "question": "Can a former employee in Colorado sue us for discrimination in state court without first filing a charge with the Colorado Civil Rights Division?",
      "expect": ["C.R.S. § 24-34-306"]
    }
  ]
}
