{
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "300000"
  },
  "permissions": {
    "allow": [
      "mcp__claude-code-remote__send_message",
      "mcp__claude-code-remote__create_session",
      "mcp__claude-code-remote__archive_session",
      "mcp__claude-code-remote__get_session",
      "mcp__claude-code-remote__list_sessions"
    ],
    "deny": [
      "Bash(gh pr *merge *--admin*)",
      "Bash(gh run *delete*)",
      "Bash(gh api *-X*/actions/runs*)",
      "Bash(gh api */actions/runs*-X*)",
      "Bash(gh api *--method*/actions/runs*)",
      "Bash(gh api */actions/runs*--method*)",
      "Bash(gh api *-X*/pages*)",
      "Bash(gh api */pages*-X*)",
      "Bash(gh api *--method*/pages*)",
      "Bash(gh api */pages*--method*)",
      "Bash(gh api *-f*/pages*)",
      "Bash(gh api */pages* -f*)",
      "Bash(gh api *-F*/pages*)",
      "Bash(gh api */pages* -F*)",
      "Bash(gh api */pages*--field*)",
      "Bash(gh api */pages*--raw-field*)",
      "Bash(gh api *--input*/pages*)",
      "Bash(gh api */pages*--input*)",
      "Bash(gh api *-X*/merge*)",
      "Bash(gh api */merge*-X*)",
      "Bash(gh api *--method*/merge*)",
      "Bash(gh api */merge*--method*)",
      "Bash(gh api *-f*/merges*)",
      "Bash(gh api */merges* -f*)",
      "Bash(gh api *-F*/merges*)",
      "Bash(gh api */merges* -F*)",
      "Bash(gh api */merges*--field*)",
      "Bash(gh api */merges*--raw-field*)",
      "Bash(gh api *--input*/merges*)",
      "Bash(gh api */merges*--input*)",
      "Bash(gh api graphql*mergePullRequest*)",
      "Bash(gh api graphql*mergeBranch*)",
      "Bash(git push* main*)",
      "Bash(git push*:main*)",
      "Bash(git push*refs/heads/main*)",
      "Bash(git push*--all*)",
      "Bash(git push*--mirror*)",
      "Bash(git -C * push* main*)",
      "Bash(git -C * push*:main*)",
      "Bash(git -C * push*refs/heads/main*)",
      "Bash(git -C * push*--all*)",
      "Bash(git -C * push*--mirror*)",
      "Bash(gh api graphql*--input*)",
      "Bash(gh api graphql*query=@*)",
      "Bash(gh api *-X*/git/refs*)",
      "Bash(gh api */git/refs*-X*)",
      "Bash(gh api *--method*/git/refs*)",
      "Bash(gh api */git/refs*--method*)",
      "Bash(gh api *-X*/contents/*)",
      "Bash(gh api */contents/*-X*)",
      "Bash(gh api *--method*/contents/*)",
      "Bash(gh api */contents/*--method*)",
      "Bash(gh api *-X*/rulesets*)",
      "Bash(gh api */rulesets*-X*)",
      "Bash(gh api *--method*/rulesets*)",
      "Bash(gh api */rulesets*--method*)",
      "Bash(gh api *-X*/protection*)",
      "Bash(gh api */protection*-X*)",
      "Bash(gh api *--method*/protection*)",
      "Bash(gh api */protection*--method*)"
    ]
  }
}
