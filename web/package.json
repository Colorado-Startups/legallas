{
  "name": "legallas-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "astro build",
    "dev": "astro build && wrangler dev --local",
    "types": "wrangler types -c wrangler.example.jsonc worker/worker-configuration.d.ts --include-env=false",
    "check": "wrangler types -c wrangler.example.jsonc worker/worker-configuration.d.ts --include-env=false && astro check && tsc -p worker && tsc -p scripts && tsc -p mcp && tsc -p mcp/apps/view && tsc -p connect/copilot",
    "test": "node scripts/run-tests.ts --test-concurrency=4 $NODE_TEST_FLAGS \"worker/**/*.test.ts\" \"mcp/**/*.test.ts\" \"scripts/**/*.test.ts\" \"src/scripts/**/*.test.ts\" \"connect/**/*.test.ts\"",
    "deploy": "astro build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "member": "node --import ./scripts/room-preload.ts scripts/member.ts",
    "access-review": "node --import ./scripts/room-preload.ts scripts/access-review.ts",
    "close-out": "node --import ./scripts/room-preload.ts scripts/close-out.ts",
    "room": "node --import ./scripts/room-preload.ts scripts/room.ts",
    "litigation": "node --import ./scripts/room-preload.ts scripts/litigation.ts",
    "sync": "node --import ./scripts/room-preload.ts scripts/sync.ts",
    "pii": "node --import ./scripts/room-preload.ts scripts/pii-cli.ts",
    "visuals": "node --import ./scripts/room-preload.ts scripts/visuals.ts",
    "eval:ask": "node --import ./scripts/room-preload.ts scripts/ask-eval.ts",
    "eval:ask-replica": "node --import ./scripts/room-preload.ts scripts/ask-replica.ts",
    "spend:days": "node --import ./scripts/room-preload.ts scripts/spend-days.ts",
    "eval:recall": "node --import ./scripts/room-preload.ts scripts/retrieval-recall.ts",
    "index:v2": "node --import ./scripts/room-preload.ts scripts/index-v2.ts",
    "eval:ask-score": "node --import ./scripts/room-preload.ts scripts/ask-eval-rescore.ts",
    "matter": "node --import ./scripts/room-preload.ts scripts/matter/cli.ts",
    "law": "node --import ./scripts/room-preload.ts scripts/law/cli.ts",
    "eval:law": "node --import ./scripts/room-preload.ts scripts/law/eval.ts",
    "dev:seed": "node --import ./scripts/room-preload.ts scripts/dev-seed.ts",
    "dev:shoot": "node --import ./scripts/room-preload.ts scripts/dev-shoot.ts",
    "mcp:dev": "wrangler dev -c wrangler.mcp.jsonc --local",
    "mcp:deploy": "wrangler deploy -c wrangler.mcp.jsonc",
    "mcp:smoke": "node --import ./scripts/room-preload.ts scripts/mcp-smoke.ts",
    "kit:run": "node --import ./scripts/room-preload.ts scripts/kit-run.ts",
    "connect:e2e": "node --import ./scripts/room-preload.ts scripts/connect-e2e.ts",
    "eval:mcp": "node --import ./scripts/room-preload.ts scripts/mcp-eval.ts",
    "counsel-pack": "node --import ./scripts/room-preload.ts scripts/counsel-pack.ts",
    "coverage": "node --import ./scripts/room-preload.ts scripts/coverage.ts",
    "checklist": "node --import ./scripts/room-preload.ts scripts/checklist/generate.ts",
    "templates": "node --import ./scripts/room-preload.ts scripts/templates/generate.ts",
    "backup": "node --import ./scripts/room-preload.ts scripts/backup.ts",
    "backup:deploy": "wrangler deploy -c wrangler.backup.jsonc",
    "harden": "node --import ./scripts/room-preload.ts scripts/harden.ts"
  },
  "dependencies": {
    "@cloudflare/ai-chat": "0.12.2",
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@expo-google-fonts/arimo": "0.4.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@rive-app/canvas": "2.50.0",
    "agents": "0.33.0",
    "ai": "7.0.169",
    "astro": "^7.4.10",
    "d3-array": "^3.2.5",
    "d3-force": "^3.0.1",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "d3-time": "^3.1.1",
    "d3-time-format": "^4.1.1",
    "jose": "^6.2.17",
    "markdown-it": "^15.0.3",
    "pdfjs-dist": "6.5.438",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/d3-array": "^3.2.2",
    "@types/d3-force": "^3.0.10",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-time": "^3.0.4",
    "@types/d3-time-format": "^4.0.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "subset-font": "2.9.0",
    "smol-toml": "1.9.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.160.0"
  }
}
