    <symbol id="vi-coins" viewBox="0 0 20 20"><ellipse cx="10" cy="5" rx="5.5" ry="2.25" /><path d="M4.5 5v9.5c0 1.25 2.5 2.25 5.5 2.25s5.5-1 5.5-2.25V5M4.5 8.25c0 1.25 2.5 2.25 5.5 2.25s5.5-1 5.5-2.25M4.5 11.5c0 1.25 2.5 2.25 5.5 2.25s5.5-1 5.5-2.25" /></symbol>
