---
// Icon sprite for the binder (card P8). Tiles reference these as <use href="#vi-<name>">. The ids are
// identifiers in the binder manifest and must match ICONS in worker/visuals.ts (binder-icons.test.ts checks);
// never rename one. Line icons on a 20px grid, 1.5px stroke, no fill: binder.css and viewer.css set the
// stroke on the outer svg and it takes currentColor.
---

<svg class="binder-sprite" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <symbol id="vi-compass" viewBox="0 0 20 20"><circle cx="10" cy="10" r="7.25" /><path d="M12.75 7.25 11.25 11.25 7.25 12.75 8.75 8.75Z" /></symbol>
    <symbol id="vi-timeline" viewBox="0 0 20 20"><circle cx="5" cy="10" r="1.5" /><circle cx="10" cy="10" r="1.5" /><circle cx="15" cy="10" r="1.5" /><path d="M2.5 10h1M6.5 10h2M11.5 10h2M16.5 10h1M5 8.5V5M10 11.5V15M15 8.5V5" /></symbol>
    <symbol id="vi-scroll" viewBox="0 0 20 20"><path d="M6.5 16.5h7a2 2 0 0 0 2-2v-11h-7a2 2 0 0 0-2 2ZM6.5 12.5h-2a2 2 0 0 0 0 4h2M15.5 3.5a2 2 0 0 1 2 2v1h-2M9 8h4M9 11h4" /></symbol>
    <symbol id="vi-quill" viewBox="0 0 20 20"><path d="M16.5 3.5C11 3.5 7.25 7 5.75 13L4.5 16.5M5.75 13c2.75 0 5.5-1.25 7-3.75M3.5 16.5h8" /></symbol>
